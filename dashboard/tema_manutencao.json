{
  "name": "Manutencao Equipamentos",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "background": "#FFFFFF",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#E34948",
  "maximum": "#0D366B",
  "center": "#5598E7",
  "minimum": "#CDE2FB",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#8A8984"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#DCDDE0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0B0B0B" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": { "solid": { "color": "#52514E" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#E6E6E3" } },
            "labelColor": { "solid": { "color": "#52514E" } },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#0B0B0B" } },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#52514E" } },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#EEF0F3" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#EEF0F3" } },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "title": [
          { "show": false }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          { "show": false }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#8A8984" } },
            "textSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#0B0B0B" } },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#8A8984" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#0B0B0B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#0B0B0B" } },
            "backColorSecondary": { "solid": { "color": "#F7F8FA" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E6E6E3" } },
            "gridVertical": false,
            "rowPadding": 6
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    }
  }
}
